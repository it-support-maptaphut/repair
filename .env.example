PORT=3000

# Admin (บังคับตั้งเอง ไม่มีค่า default ในโค้ด)
ADMIN_USER=
ADMIN_PASS=
ADMIN_SECRET=

# Cloudinary (ที่เก็บรูปถ่าย)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase (ฐานข้อมูลตัวกลาง)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL Direct Connection (สำหรับโหมดเชื่อมต่อโดยตรง)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=
PG_SSL=false

# Google Sheet Web App URL (ได้จาก Apps Script -> Deploy Web app)
GOOGLE_SHEETS_URL=https://script.google.com/macros/s/XXXX/exec

# ---- PASSWORD NOTE ----
# ไม่มีค่า default ในโค้ดแล้ว ถ้าว่างไว้ระบบบันทึกรหัสผ่านจะปิดใช้งาน
PASSWORD_NOTE_KEY=wan2024
PASSWORD_NOTE_PIN=741236
PASSWORD_NOTE_PASS=wan2024

# ---- Key Pass ผู้ใช้ภายนอก ----
# pepper สำหรับคำนวณ keypass_lookup (HMAC-SHA256) — สุ่มยาว 32-64 ตัวอักษร
# ต้องรันไฟล์ supabase-migrate-keypass.sql ใน Supabase ก่อนใช้งาน
# !! ห้ามเปลี่ยนค่านี้ ถ้าเปลี่ยน Key Pass ที่ออกไปแล้วทั้งหมดจะใช้ไม่ได้
# !! ห้าม commit ค่านี้ขึ้น git และห้ามใส่ค่าจริงในไฟล์นี้
VISITOR_KEYPASS_PEPPER=

# คีย์เข้ารหัสสำหรับ "ให้ผู้ใช้ดู/คัดลอก Key Pass ของตัวเอง" ในหน้า Settings
# ต้องรันไฟล์ supabase-migrate-keypass-enc.sql ใน Supabase ก่อนใช้งาน
# ถ้ายังไม่มีคอลัมน์ keypass_enc ระบบจะใช้งาน Key Pass ไม่ได้
# %% เหมือน pepper: ห้ามเปลี่ยนค่านี้เพราะจะถอดรหัส Key Pass เดิมไม่ออก และห้าม commit ค่านี้
VISITOR_KEYPASS_ENC_KEY=

# ---- LINE Login (เข้าสู่ระบบด้วย LINE) ----
# สร้างจาก LINE Developers Console -> LINE Login channel
# ต้องตั้ง Callback URL = https://<โดเมนของคุณ>/auth/line/callback ให้ตรงกับเว็บจริง
# ต้องรันไฟล์ supabase-migrate-line.sql ใน Supabase ก่อนใช้งาน
# !! ห้าม commit ค่าจริงขึ้น git
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
