PORT=3000

# Admin (บังคับตั้งเอง ไม่มีค่า default ในโค้ด)
ADMIN_USER=
ADMIN_PASS=
# สุ่มยาว ๆ (เช่น openssl rand -hex 48) — ใช้เซ็น session ของ admin
ADMIN_SECRET=
# แยกคีย์ตามชนิดผู้ใช้ (แนะนำ; ถ้าว่างจะใช้ ADMIN_SECRET แทน)
# openssl rand -hex 48
USER_SECRET=
VISITOR_SECRET=

# ---------- Proxy / เครือข่าย ----------
# จำนวนชั้น reverse proxy ที่เชื่อถือได้ (Vercel/Cloudflare = 1) — ห้ามตั้ง true
TRUST_PROXY=1
# รายการ host ฐานข้อมูลที่อนุญาตเพิ่มเติม (คั่นด้วย ,) เช่น db.mycompany.local
# ค่าเริ่มต้นอนุญาต: PG_HOST, *.supabase.co, *.supabase.com, *.pooler.supabase.com
ALLOWED_DB_HOSTS=

# Cloudinary (ที่เก็บรูปถ่าย)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase (ฐานข้อมูลตัวกลาง)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL Direct Connection (สำหรับโหมดเชื่อมต่อโดยตรง)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=
PG_SSL=false

# Google Sheet Web App URL (ได้จาก Apps Script -> Deploy Web app)
GOOGLE_SHEETS_URL=https://script.google.com/macros/s/XXXX/exec

# ---- PASSWORD NOTE ----
# ถ้าว่างไว้ระบบบันทึกรหัสผ่านจะปิดใช้งาน
# !! ห้ามใส่ค่า default/ค่าที่คาดเดาได้ — สุ่มใหม่ทั้งหมด
# PASSWORD_NOTE_KEY = base64 ของคีย์ 32 ไบต์: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASSWORD_NOTE_KEY=
# PIN และรหัสผ่านสำหรับยืนยันตัวตนก่อนบันทึก/แก้ไขโน้ตรหัสผ่าน
PASSWORD_NOTE_PIN=
PASSWORD_NOTE_PASS=

# ---- Key Pass ผู้ใช้ภายนอก ----
# pepper สำหรับคำนวณ keypass_lookup (HMAC-SHA256) — สุ่มยาว 32-64 ตัวอักษร
# ต้องรันไฟล์ supabase-migrate-keypass.sql ใน Supabase ก่อนใช้งาน
# !! ห้ามเปลี่ยนค่านี้ ถ้าเปลี่ยน Key Pass ที่ออกไปแล้วทั้งหมดจะใช้ไม่ได้
# !! ห้าม commit ค่านี้ขึ้น git และห้ามใส่ค่าจริงในไฟล์นี้
VISITOR_KEYPASS_PEPPER=

# คีย์เข้ารหัสสำหรับ "ให้ผู้ใช้ดู/คัดลอก Key Pass ของตัวเอง" ในหน้า Settings
# ต้องรันไฟล์ supabase-migrate-keypass-enc.sql ใน Supabase ก่อนใช้งาน
# ถ้ายังไม่มีคอลัมน์ keypass_enc ระบบจะใช้งาน Key Pass ไม่ได้
# %% เหมือน pepper: ห้ามเปลี่ยนค่านี้เพราะจะถอดรหัส Key Pass เดิมไม่ออก และห้าม commit ค่านี้
VISITOR_KEYPASS_ENC_KEY=

# ---- LINE Login (เข้าสู่ระบบด้วย LINE) ----
# สร้างจาก LINE Developers Console -> LINE Login channel
# ต้องตั้ง Callback URL = https://<โดเมนของคุณ>/auth/line/callback ให้ตรงกับเว็บจริง
# ต้องรันไฟล์ supabase-migrate-line.sql ใน Supabase ก่อนใช้งาน
# !! ห้าม commit ค่าจริงขึ้น git
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE OA (Messaging API) — @id ของ OA ใช้สร้างปุ่ม/QR เพิ่มเพื่อน (ใส่ @ หรือไม่ก็ได้)
LINE_OA_ID=
