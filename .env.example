PORT=3000

# Admin (บังคับตั้งเอง ไม่มีค่า default ในโค้ด)
ADMIN_USER=
ADMIN_PASS=
ADMIN_SECRET=

# Cloudinary (ที่เก็บรูปถ่าย)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase (ฐานข้อมูลตัวกลาง)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL Direct Connection (สำหรับโหมดเชื่อมต่อโดยตรง)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=
PG_SSL=false

# Google Sheet Web App URL (ได้จาก Apps Script -> Deploy Web app)
GOOGLE_SHEETS_URL=https://script.google.com/macros/s/XXXX/exec

# PASSWORD NOTE
PASSWORD_NOTE_KEY=
PASSWORD_NOTE_PIN=741236
PASSWORD_NOTE_PASS=wan2024*

# ---- บัญชีผู้ใช้ภายนอก (v1.0.1) ----
# คีย์เข้ารหัสรหัสผ่านผู้ใช้ (AES-256-GCM) ค้านจาก ADMIN_SECRET
# ถ้าเปลี่ยน ADMIN_SECRET รหัสผ่านที่แสดงในหน้าตั้งค่าจะถอดรหัสไม่ได้ (ล็อกอินยังได้ปกติ)
# ต้องรันไฟล์ supabase-migrate-account.sql ใน Supabase ก่อนใช้งานบัญชีผู้ใช้
